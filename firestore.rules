rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Domain validation helpers
    function isValidUnit(unit) {
      return unit is string && (unit == 'ML' || unit == 'OZ');
    }

    function isValidBeverageType(beverageType) {
      return beverageType is string && (
        beverageType == 'WATER' ||
        beverageType == 'SPARKLING' ||
        beverageType == 'HERBAL_TEA' ||
        beverageType == 'GREEN_TEA' ||
        beverageType == 'ELECTROLYTES' ||
        beverageType == 'COFFEE'
      );
    }

    function isValidDayKey(dayKey) {
      return dayKey is string && dayKey.size() == 10 && dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             data.dailyGoalMl is int &&
             data.dailyGoalMl >= 500 &&
             data.dailyGoalMl <= 10000 &&
             isValidUnit(data.unit) &&
             data.quickPresetSmallMl is int &&
             data.quickPresetSmallMl >= 50 &&
             data.quickPresetSmallMl <= 2000 &&
             data.quickPresetMediumMl is int &&
             data.quickPresetMediumMl >= 50 &&
             data.quickPresetMediumMl <= 2000 &&
             data.quickPresetLargeMl is int &&
             data.quickPresetLargeMl >= 50 &&
             data.quickPresetLargeMl <= 2000 &&
             data.wakeHour is int &&
             data.wakeHour >= 0 &&
             data.wakeHour <= 23 &&
             data.sleepHour is int &&
             data.sleepHour >= 0 &&
             data.sleepHour <= 23;
    }

    function isValidIntakeLog(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.amountMl is int &&
             data.amountMl >= 1 &&
             data.amountMl <= 5000 &&
             data.effectiveMl is int &&
             data.effectiveMl >= 1 &&
             data.effectiveMl <= 6000 &&
             isValidBeverageType(data.beverageType) &&
             isValidDayKey(data.dayKey) &&
             data.loggedAtMillis is int &&
             data.loggedAtMillis >= 0 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 140));
    }

    // User Hydration Profile: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'dailyGoalMl', 'unit',
                         'quickPresetSmallMl', 'quickPresetMediumMl', 'quickPresetLargeMl',
                         'wakeHour', 'sleepHour', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'dailyGoalMl', 'unit',
                         'quickPresetSmallMl', 'quickPresetMediumMl', 'quickPresetLargeMl',
                         'wakeHour', 'sleepHour', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isValidUserProfile(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'dailyGoalMl', 'unit',
                         'quickPresetSmallMl', 'quickPresetMediumMl', 'quickPresetLargeMl',
                         'wakeHour', 'sleepHour', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Intake Logs Subcollection: /users/{userId}/intakeLogs/{logId}
      match /intakeLogs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(logId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'amountMl', 'effectiveMl', 'beverageType',
                           'dayKey', 'loggedAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'amountMl', 'effectiveMl', 'beverageType',
                           'dayKey', 'note', 'loggedAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidIntakeLog(incoming());

        allow update: if isValidIntakeLog(incoming()) &&
                         isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'amountMl', 'effectiveMl', 'beverageType',
                           'dayKey', 'note', 'loggedAtMillis', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
